# Скопируйте файл в .env и заполните значения.
# .env добавлен в .gitignore и НЕ должен попадать в репозиторий.

# Токен Telegram-бота, полученный у @BotFather
BOT_TOKEN="your_telegram_bot_token_here"

# Порт HTTP API
PORT=3000

# Окружение: development | production | test
NODE_ENV=development

# Необязательно: файл для сохранения состояния между перезапусками.
# Если не задан — данные хранятся только в памяти.
# DATA_FILE=./data.json
